#!/usr/bin/env node
'use strict';

const path = require('path');
const core = require(path.join(__dirname, '..', 'lib', 'core.js'));
const configLib = require(path.join(__dirname, '..', 'lib', 'config.js'));
const runtimeLib = require(path.join(__dirname, '..', 'lib', 'runtime.js'));
const safeModeLib = require(path.join(__dirname, '..', 'lib', 'safe-mode.js'));

const VERSION = '0.1.0-unrestricted';
const BASE_ON = '0.2.2-rc.1';

let runtime = null;
let config = null;
let coreCtx = null;

function init(opts = {}) {
  config = configLib.load(opts.configPath);
  if (opts.forceSafe === true) config = configLib.applySafeMode(config, true);
  if (opts.forceUnsafe === true) config = safeModeLib.ensureSafeModeOff(config);
  coreCtx = core.createCore();
  return { config, core: coreCtx };
}

function print(msg) {
  process.stdout.write(msg + '\n');
}

function pluginsList() {
  const list = (coreCtx.app.agentPresetPlugins || []);
  if (list.length === 0) {
    return ['  (no plugins registered)'];
  }
  return list.map((p, i) => {
    const unrestricted = p.id === 'gopurge-preset-persona' ? ' — UNRESTRICTED' : '';
    return `  ${i + 1}. ${p.id} (${p.name})${unrestricted}`;
  });
}

async function cmdStart(argv) {
  init({ forceUnsafe: true });
  const { agentPresets, systemPrompt } = coreCtx;
  systemPrompt.registerSection('harness', 'DSH-Go Unrestricted Runtime');
  const presetPlugins = await agentPresets.register({
    plugins: config.agentPresets ? [] : [],
  });
  const persona = (presetPlugins[0] && presetPlugins[0].config && presetPlugins[0].config.personaPrefix) || '';
  runtime = new runtimeLib.Runtime(config);
  try {
    await runtime.start();
    print('✓ dsh-go server started on http://' + config.host + ':' + config.port);
    print('  PID: ' + process.pid);
    print('  Safe mode: OFF');
    print('  Plugins: ' + presetPlugins.length + ' active (' + (persona.split('\n').length) + ' persona lines)');
    print('  Build: based on DSH ' + BASE_ON);
    if (argv.indexOf('--foreground') === -1) {
      process.on('SIGINT', async () => { await runtime.stop(); process.exit(0); });
    }
  } catch (e) {
    print('✗ failed to start: ' + e.message);
    process.exitCode = 1;
  }
}

async function cmdStop() {
  if (runtime) await runtime.stop();
  print('✓ server stopped');
}

async function cmdStatus() {
  if (!runtime) {
    init({ forceUnsafe: true });
    runtime = new runtimeLib.Runtime(config);
  }
  const s = runtime.status();
  print('State:    ' + s.state);
  print('URL:      ' + s.url);
  print('Version:  ' + s.version);
  print('SafeMode: ' + (s.safeMode ? 'ON' : 'OFF'));
}

function cmdVersion() {
  print('dsh-go v' + VERSION + ' (based on DSH v' + BASE_ON + ')');
  print('Build:    unrestricted');
}

function cmdConfig(argv) {
  init();
  const sub = argv[0];
  if (sub === 'get') {
    print(String(configLib.get(config, argv[1])));
  } else if (sub === 'set') {
    configLib.set(config, argv[1], parseValue(argv[2]));
    const file = configLib.save(config);
    print('✓ saved: ' + file);
  } else if (sub === 'list') {
    print(JSON.stringify(config, null, 2));
  } else {
    print('usage: dsh-go config <get|set|list> [key] [value]');
  }
}

async function cmdPlugins() {
  init({ forceUnsafe: true });
  await coreCtx.agentPresets.register({ plugins: [] });
  print('Registered agent preset plugins:');
  for (const line of pluginsList()) print(line);
}

function cmdSafeMode(argv) {
  const action = argv[0] || 'status';
  if (action === 'off') {
    print('Safe mode: OFF (all plugins enabled, persona overridden)');
  } else if (action === 'on') {
    const bundle = safeModeLib.buildSafeModeBundle();
    print('Safe mode bundle built (rescue profile):');
    print(JSON.stringify(bundle, null, 2));
  } else {
    init();
    print('Safe mode: ' + (config.safeMode ? 'ON' : 'OFF'));
  }
}

function parseValue(v) {
  if (v === 'true') return true;
  if (v === 'false') return false;
  const n = Number(v);
  if (!Number.isNaN(n) && v !== '') return n;
  return v;
}

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0] || 'status';
  switch (cmd) {
    case 'start':    return cmdStart(argv.slice(1));
    case 'stop':     return cmdStop();
    case 'status':   return cmdStatus();
    case 'restart':  await cmdStop(); return cmdStart(argv.slice(1));
    case 'version':
    case '-v':
    case '--version': return cmdVersion();
    case 'config':   return cmdConfig(argv.slice(1));
    case 'plugins':  return cmdPlugins();
    case 'safe-mode':
    case 'safemode': return cmdSafeMode(argv.slice(1));
    default:
      print('dsh-go v' + VERSION + ' — unrestricted build');
      print('');
      print('Usage:');
      print('  dsh-go start                Start the server');
      print('  dsh-go stop                 Stop the server');
      print('  dsh-go restart              Restart the server');
      print('  dsh-go status               Show runtime status');
      print('  dsh-go version              Show version');
      print('  dsh-go config get <key>     Read a config value');
      print('  dsh-go config set <key> <v> Write a config value');
      print('  dsh-go config list          Dump full config');
      print('  dsh-go plugins list         List agent preset plugins');
      print('  dsh-go safe-mode [off|on]   Control safe mode (default off)');
      process.exitCode = 1;
  }
}

main().catch((e) => { process.stderr.write(String(e) + '\n'); process.exitCode = 1; });
